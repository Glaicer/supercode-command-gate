{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@supercode/command-gate",
  "version": "1.0.4",
  "private": false,
  "type": "module",
  "description": "OpenCode V2 Command Gate for the aar Command Reviewer",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./plugin": "./dist/plugin.js",
    "./server": "./index.js",
    "./tui": "./tui.js",
    "./rpc": "./rpc.js"
  },
  "files": [
    "README.md",
    "index.js",
    "tui.js",
    "rpc.js",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test 'src/**/*.test.ts'",
    "test:seam": "node --test test/seam.test.mjs",
    "test:approval": "node --test test/approval.test.mjs",
    "compile": "tsc --project tsconfig.release.json",
    "compile:tui": "tsc --project tsconfig.release.json",
    "prepack": "pnpm compile",
    "test:package": "node --test test/package.test.mjs",
    "test:packed": "GATE_PACKED=1 node --test --test-concurrency=1 'test/*.test.mjs'",
    "test:all": "node --test --test-concurrency=1 'src/**/*.test.ts' 'test/*.test.mjs'",
    "test:human:packed": "GATE_PACKED=1 GATE_HUMAN=1 node --test test/human.test.mjs",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check 'src/**/*.ts' 'test/**/*.mjs' '*.ts' '*.json'"
  },
  "//": "Pins verified 2026-10-03 against registry.npmjs.org: @opencode/plugin must equal the host version (2.0.22) and declares effect 4.0.0-rc.112 itself, so both stay exact here.",
  "dependencies": {
    "@opencode/plugin": "2.0.22",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "prettier": "3.9.9",
    "solid-js": "1.9.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24",
    "opencode": "2.0.22"
  }
}
